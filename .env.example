# Copy to .env (git-ignored) for `docker compose up`. Jenkins does not use this file.
DB_URL=jdbc:mysql://192.168.100.30:3309/db_asset?useSSL=false&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true
DB_USERNAME=
DB_PASSWORD=
# At least 32 characters. Anyone holding it can mint a valid sign-in token.
JWT_SECRET=
# false skips the password check (anyone knowing an emp_code can sign in). Keep true when shared.
LOGIN_PASSWORD_VERIFY=true
